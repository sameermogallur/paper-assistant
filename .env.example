# Copy this file to .env and fill values

# REQUIRED: Used for polite Crossref API access
CROSSREF_EMAIL=you@example.com

# OPTIONAL: Enables AI summary in Streamlit
OPENAI_API_KEY=

# OPTIONAL (Windows): Path to Poppler bin for pdf2image
# POPPLER_PATH=C:\path\to\poppler-xx\Library\bin

# CORS origins (comma-separated). Defaults to the local frontends
# (5173 React dev, 3000 alt, 8501 Streamlit). Setting "*" makes the API
# public and cookie-less: credentials are disabled with a wildcard.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# Limits (optional)
# MAX_PDF_SIZE_MB=10
# MAX_PDF_PAGES=100
# MAX_OCR_PAGES=20

# OPTIONAL: OpenAlex related-papers lookup (defaults to CROSSREF_EMAIL)
# OPENALEX_MAILTO=you@example.com
# OPENALEX_CONCURRENT_REQUESTS=3

# OPTIONAL (frontend): Base URL the React app calls.
# Read by Vite, NOT by the backend — it must live in frontend/.env, not this
# file (Vite loads env from its own project root). Defaults to the local
# backend, so it only needs setting if the API is not on localhost:8000.
# VITE_API_URL=http://localhost:8000
